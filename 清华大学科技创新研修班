                    if (!res.ok) throw new Error('Failed to fetch Open-Meteo weather');
                    const json = await res.json();
                    const current = json.current;
                    const wInfo = getWeatherDetailsByCode(current.weather_code);
                    setLiveWeather({
                        temp: `${Math.round(current.temperature_2m)}°C`,
                        apparentTemp: `${Math.round(current.apparent_temperature)}°C`,
                        condition_zh: wInfo.zh,
                        condition_en: wInfo.en,
                        icon: wInfo.icon,
