                                            <span className="w-1.5 h-1.5 bg-[#660874] rounded-full animate-bounce"></span>
                                            <span className="w-1.5 h-1.5 bg-[#660874] rounded-full animate-bounce [animation-delay:0.15s]"></span>
                                            <span className="w-1.5 h-1.5 bg-[#660874] rounded-full animate-bounce [animation-delay:0.3s]"></span>
                                        </div>
                                    )}
                                </div>

                                {/* Chat Input Area */}
                                <form 
                                    onSubmit={(e) => {
                                        e.preventDefault();
                                        handleSendChatMessage(chatInput);
                                    }}
                                    className="no-drag p-2.5 bg-white border-t border-stone-200 flex items-center gap-2"
                                >
                                    <input 
                                        type="text" 
                                        value={chatInput} 
                                        onChange={(e) => setChatInput(e.target.value)} 
                                        placeholder={lang === 'zh' ? "询问美食、预算、天气、交通..." : "Ask food, budget, weather, subway..."} 
                                        className="flex-1 bg-stone-100 border border-stone-200 rounded-full px-3.5 py-2 text-xs outline-none focus:border-[#660874] focus:bg-white"
                                    />
                                    <button 
                                        type="submit" 
                                        className="w-8 h-8 rounded-full bg-[#660874] text-white flex items-center justify-center hover:bg-[#43044d] transition shadow-xs flex-shrink-0 disabled:opacity-40"
                                        disabled={!chatInput.trim()}
                                    >
                                        <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                    </button>
                                </form>

                            </div>
                        )}
                    </div>

                    {/* Admin Login Modal */}
                    {showAdminLogin && (
                        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
                            <div className="bg-white rounded-3xl p-6 sm:p-8 max-w-sm w-full shadow-2xl border border-stone-200">
                                <h3 className="serif-title text-xl font-bold text-slate-900 mb-1">
                                    {lang === 'zh' ? '管理员身份验证' : 'Admin Authentication'}
                                </h3>
                                <p className="text-xs text-stone-500 mb-5">
                                    {lang === 'zh' 
                                        ? '请输入已授权的邮箱（超级管理员：maymay6002@gmail.com 或 laishengchet@moe.gov.my）'
                                        : 'Please enter authorized admin email'}
                                </p>

                                <form onSubmit={handleAdminLogin} className="space-y-4">
                                    <div>
                                        <input 
                                            type="email" 
                                            placeholder="maymay6002@gmail.com / laishengchet@moe.gov.my" 
                                            value={adminEmail} 
                                            onChange={e => setAdminEmail(e.target.value)}
                                            className="w-full border border-stone-300 rounded-xl p-3 text-sm focus:border-[#660874] outline-none"
                                            required
                                        />
                                        {loginError && <p className="text-red-500 text-xs mt-1.5">{loginError}</p>}
                                    </div>

                                    <div className="flex gap-2">
                                        <button 
                                            type="button" 
                                            onClick={() => setShowAdminLogin(false)}
                                            className="flex-1 py-2.5 rounded-xl text-xs font-bold bg-stone-100 hover:bg-stone-200 text-stone-700 transition"
                                        >
                                            {lang === 'zh' ? '取消' : 'Cancel'}
                                        </button>
                                        <button 
                                            type="submit" 
                                            className="flex-1 py-2.5 rounded-xl text-xs font-bold bg-[#660874] hover:bg-[#43044d] text-white transition shadow-md"
                                        >
                                            {lang === 'zh' ? '确认登录' : 'Confirm Login'}
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    )}

                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
