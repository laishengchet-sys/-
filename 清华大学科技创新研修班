            // Drag handler for chatbot
            const handleMouseDown = (e) => {
                if (e.target.closest('.no-drag')) return;
                const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
                const clientY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;

                const currentX = chatPos.x !== null ? chatPos.x : (window.innerWidth - (isChatOpen ? 400 : 180));
                const currentY = chatPos.y !== null ? chatPos.y : (window.innerHeight - (isChatOpen ? 560 : 90));

                dragStartRef.current = {
                    startX: clientX,
                    startY: clientY,
                    origX: currentX,
                    origY: currentY,
                    moved: false
                };

                setIsDragging(true);

                const handleMouseMove = (moveEvent) => {
                    const moveX = moveEvent.type.includes('touch') ? moveEvent.touches[0].clientX : moveEvent.clientX;
                    const moveY = moveEvent.type.includes('touch') ? moveEvent.touches[0].clientY : moveEvent.clientY;
                    
                    const deltaX = moveX - dragStartRef.current.startX;
                    const deltaY = moveY - dragStartRef.current.startY;

                    if (Math.abs(deltaX) > 4 || Math.abs(deltaY) > 4) {
                        dragStartRef.current.moved = true;
                    }

                    const width = isChatOpen ? 380 : 160;
                    const height = isChatOpen ? 520 : 60;
                    
                    const newX = Math.max(10, Math.min(window.innerWidth - width - 10, dragStartRef.current.origX + deltaX));
                    const newY = Math.max(10, Math.min(window.innerHeight - height - 10, dragStartRef.current.origY + deltaY));

                    setChatPos({ x: newX, y: newY });
                };

                const handleMouseUp = () => {
                    setIsDragging(false);
                    window.removeEventListener('mousemove', handleMouseMove);
                    window.removeEventListener('mouseup', handleMouseUp);
                    window.removeEventListener('touchmove', handleMouseMove);
                    window.removeEventListener('touchend', handleMouseUp);
                };

