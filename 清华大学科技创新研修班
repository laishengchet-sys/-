            // Weather code mapper (WMO Interpretation)
            const getWeatherDetailsByCode = (code) => {
                if (code === 0) return { zh: '晴朗无云', en: 'Clear Sky', icon: '☀️' };
                if ([1, 2].includes(code)) return { zh: '晴间多云', en: 'Partly Cloudy', icon: '🌤️' };
                if (code === 3) return { zh: '阴天多云', en: 'Overcast', icon: '☁️' };
                if ([45, 48].includes(code)) return { zh: '轻雾', en: 'Foggy', icon: '🌫️' };
                if ([51, 53, 55, 61, 63, 65].includes(code)) return { zh: '小雨/中雨', en: 'Rainy', icon: '🌧️' };
                if ([71, 73, 75, 77, 85, 86].includes(code)) return { zh: '小雪', en: 'Light Snow', icon: '❄️' };
                if ([80, 81, 82].includes(code)) return { zh: '阵雨', en: 'Showers', icon: '🌦️' };
                if ([95, 96, 99].includes(code)) return { zh: '雷阵雨', en: 'Thunderstorm', icon: '⛈️' };
                return { zh: '多云天清', en: 'Partly Cloudy', icon: '🌤️' };
            };

            // Fetch live Beijing weather with graceful fallback
